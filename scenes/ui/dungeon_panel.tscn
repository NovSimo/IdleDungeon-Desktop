[gd_scene load_steps=3 format=3 uid="uid://bdungeon_panel"]

[ext_resource type="Script" path="res://scripts/ui/dungeon_panel.gd" id="1_dp"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_config"]
bg_color = Color(0.145098, 0.145098, 0.180392, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(1, 0.643137, 0, 0.5)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4

[node name="DungeonPanel" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_dp")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 6

# ============================================================
# 标题栏
# ============================================================
[node name="TitleBar" type="HBoxContainer" parent="VBox"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="TitleLabel" type="Label" parent="VBox/TitleBar"]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "🏰 地牢"

[node name="ConnectionIndicator" type="Label" parent="VBox/TitleBar"]
layout_mode = 2
theme_override_font_sizes/font_size = 14
text = "●"

[node name="HSpacer" type="Control" parent="VBox/TitleBar"]
layout_mode = 2
size_flags_horizontal = 3

# ============================================================
# 地牢列表
# ============================================================
[node name="HSeparator" type="HSeparator" parent="VBox"]
layout_mode = 2

[node name="DungeonScroll" type="ScrollContainer" parent="VBox"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="DungeonList" type="VBoxContainer" parent="VBox/DungeonScroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="PlaceholderLabel" type="Label" parent="VBox/DungeonScroll/DungeonList"]
layout_mode = 2
theme_override_colors/font_color = Color(0.533333, 0.533333, 0.533333, 1)
text = "暂无地牢"

# ============================================================
# 探险配置面板
# ============================================================
[node name="ExploreConfigPanel" type="PanelContainer" parent="VBox"]
visible = false
layout_mode = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_config")

[node name="VBox" type="VBoxContainer" parent="VBox/ExploreConfigPanel"]
layout_mode = 2
offset_left = 8.0
offset_top = 8.0
offset_right = -8.0
offset_bottom = -8.0
theme_override_constants/separation = 8

[node name="SelectedDungeonLabel" type="Label" parent="VBox/ExploreConfigPanel/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.643137, 0, 1)
theme_override_font_sizes/font_size = 16
text = "🏰 哥布林洞穴"

[node name="DungeonInfoLabel" type="Label" parent="VBox/ExploreConfigPanel/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.533333, 0.533333, 0.533333, 1)
theme_override_font_sizes/font_size = 12
text = "层数: 1-5  |  推荐等级: Lv.3"

[node name="CharacterSelectLabel" type="Label" parent="VBox/ExploreConfigPanel/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.533333, 0.533333, 0.533333, 1)
theme_override_font_sizes/font_size = 12
text = "选择角色:"

[node name="CharacterSelect" type="OptionButton" parent="VBox/ExploreConfigPanel/VBox"]
layout_mode = 2
text = "战士·李四"
item_count = 1
selected = 0

[node name="StartButton" type="Button" parent="VBox/ExploreConfigPanel/VBox"]
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.643137, 0, 1)
theme_override_font_sizes/font_size = 16
text = "⚔️ 开始探险"

# ============================================================
# 进行中的探险
# ============================================================
[node name="ActivePanel" type="PanelContainer" parent="VBox"]
visible = false
layout_mode = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_config")

[node name="VBox" type="VBoxContainer" parent="VBox/ActivePanel"]
layout_mode = 2
offset_left = 8.0
offset_top = 8.0
offset_right = -8.0
offset_bottom = -8.0
theme_override_constants/separation = 6

[node name="ActiveDungeonLabel" type="Label" parent="VBox/ActivePanel/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.643137, 0, 1)
theme_override_font_sizes/font_size = 16
text = "🏰 哥布林洞穴"

[node name="ActiveCharacterLabel" type="Label" parent="VBox/ActivePanel/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.533333, 0.533333, 0.533333, 1)
theme_override_font_sizes/font_size = 12
text = "🧙 战士·李四 探险中..."

[node name="ActiveFloorLabel" type="Label" parent="VBox/ActivePanel/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.643137, 0, 1)
theme_override_font_sizes/font_size = 14
text = "第 3/5 层"

[node name="ActiveProgress" type="ProgressBar" parent="VBox/ActivePanel/VBox"]
custom_minimum_size = Vector2(0, 8)
layout_mode = 2
max_value = 100.0
value = 60.0
show_percentage = false

[node name="ClaimButton" type="Button" parent="VBox/ActivePanel/VBox"]
custom_minimum_size = Vector2(0, 36)
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.843137, 0, 1)
theme_override_font_sizes/font_size = 14
text = "剩余 30s"

[connection signal="pressed" from="VBox/ExploreConfigPanel/VBox/StartButton" to="." method="_on_start_button_pressed"]
[connection signal="pressed" from="VBox/ActivePanel/VBox/ClaimButton" to="." method="_on_claim_button_pressed"]

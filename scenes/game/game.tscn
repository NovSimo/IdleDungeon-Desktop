[gd_scene load_steps=8 format=3 uid="uid://bgame_scene_v2"]

[ext_resource type="Script" path="res://scenes/game/game.gd" id="1_game"]
[ext_resource type="Script" path="res://scripts/components/floating_window_manager.gd" id="2_fwm"]
[ext_resource type="Script" path="res://scripts/ui/dynamic_scene.gd" id="3_ds"]
[ext_resource type="Script" path="res://scripts/ui/resource_bar.gd" id="4_rb"]
[ext_resource type="PackedScene" path="res://scenes/ui/character_panel.tscn" id="5_cp"]
[ext_resource type="PackedScene" path="res://scenes/ui/management_panel.tscn" id="6_mp"]
[ext_resource type="PackedScene" path="res://scenes/ui/dungeon_panel.tscn" id="7_dp"]

[node name="GameScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_game")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.05, 0.05, 0.1, 0.98)

[node name="FloatingWindowManager" type="Node" parent="."]
script = ExtResource("2_fwm")

# ============================================================
# 主布局 (VBox)
# ============================================================
[node name="MainLayout" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 0

# --- 标题栏 ---
[node name="TopBar" type="HBoxContainer" parent="MainLayout"]
layout_mode = 2
custom_minimum_size = Vector2(0, 36)
theme_override_constants/separation = 10

[node name="GameTitle" type="Label" parent="MainLayout/TopBar"]
layout_mode = 2
theme_override_font_sizes/font_size = 14
text = "🏰 悬浮地牢"

[node name="TabButtons" type="HBoxContainer" parent="MainLayout/TopBar"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="ManageTabBtn" type="Button" parent="MainLayout/TopBar/TabButtons"]
layout_mode = 2
custom_minimum_size = Vector2(60, 28)
theme_override_colors/font_color = Color(0.9, 0.9, 0.9, 1)
theme_override_font_sizes/font_size = 11
text = "🌾经营"

[node name="DungeonTabBtn" type="Button" parent="MainLayout/TopBar/TabButtons"]
layout_mode = 2
custom_minimum_size = Vector2(60, 28)
theme_override_colors/font_color = Color(0.9, 0.9, 0.9, 1)
theme_override_font_sizes/font_size = 11
text = "🗡️地牢"

[node name="SettingsTabBtn" type="Button" parent="MainLayout/TopBar/TabButtons"]
layout_mode = 2
custom_minimum_size = Vector2(60, 28)
theme_override_colors/font_color = Color(0.9, 0.9, 0.9, 1)
theme_override_font_sizes/font_size = 11
text = "⚙️设置"

[node name="HSpacer" type="Control" parent="MainLayout/TopBar"]
layout_mode = 2
size_flags_horizontal = 3

[node name="ModeButton" type="Button" parent="MainLayout/TopBar"]
layout_mode = 2
custom_minimum_size = Vector2(50, 28)
theme_override_font_sizes/font_size = 10
text = "完整▽"

[node name="ConnectionIndicator" type="ColorRect" parent="MainLayout/TopBar"]
custom_minimum_size = Vector2(10, 10)
layout_mode = 2
color = Color.RED

# --- 动态采集场景区域 ---
[node name="SceneArea" type="Control" parent="MainLayout"]
layout_mode = 2
custom_minimum_size = Vector2(0, 160)
size_flags_vertical = 0

[node name="DynamicScene" type="Control" parent="MainLayout/SceneArea"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("3_ds")

# --- 资源显示条 ---
[node name="ResourceBarContainer" type="PanelContainer" parent="MainLayout"]
layout_mode = 2
custom_minimum_size = Vector2(0, 36)

[node name="ResourceBar" type="HBoxContainer" parent="MainLayout/ResourceBarContainer"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 12.0
offset_top = 6.0
offset_right = -12.0
offset_bottom = -6.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("4_rb")

# --- 角色卡片横向滚动行 ---
[node name="CharCardRow" type="ScrollContainer" parent="MainLayout"]
layout_mode = 2
custom_minimum_size = Vector2(0, 100)
size_flags_vertical = 0
horizontal_scroll_mode = 2

[node name="CardContainer" type="HBoxContainer" parent="MainLayout/CharCardRow"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
alignment = 1
theme_override_constants/separation = 8

# --- 底部状态栏 ---
[node name="BottomStatusBar" type="PanelContainer" parent="MainLayout"]
layout_mode = 2
custom_minimum_size = Vector2(0, 30)

[node name="BottomContent" type="HBoxContainer" parent="MainLayout/BottomStatusBar"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 10.0
offset_top = 4.0
offset_right = -10.0
offset_bottom = -4.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 16

[node name="StatusLeft" type="HBoxContainer" parent="MainLayout/BottomStatusBar/BottomContent"]
layout_mode = 2
theme_override_constants/separation = 12
theme_override_font_sizes/font_size = 11

[node name="InventoryLabel" type="Label" parent="MainLayout/BottomStatusBar/BottomContent/StatusLeft"]
layout_mode = 2
text = "📦库存 0"

[node name="CharacterCountLabel" type="Label" parent="MainLayout/BottomStatusBar/BottomContent/StatusLeft"]
layout_mode = 2
text = "👥 0/12"

[node name="FacilityLabel" type="Label" parent="MainLayout/BottomStatusBar/BottomContent/StatusLeft"]
layout_mode = 2
text = "🏠设施 Lv.-"

[node name="Spacer" type="Control" parent="MainLayout/BottomStatusBar/BottomContent"]
layout_mode = 2
size_flags_horizontal = 3

[node name="TimerLabel" type="Label" parent="MainLayout/BottomStatusBar/BottomContent"]
layout_mode = 2
theme_override_colors/font_color = Color(0.533333, 0.533333, 0.533333, 1)
theme_override_font_sizes/font_size = 11
text = "⏰ --:--"

# ============================================================
# 弹出覆盖层（经营/地牢面板，默认隐藏）
# ============================================================

# 经营管理覆盖层
[node name="ManagementOverlay" type="PanelContainer" parent="."]
visible = false
layout_mode = 1
anchors_preset = Control.PRESET_FULL_RECT
script = ExtResource("6_mp")

# 地牢覆盖层
[node name="DungeonOverlay" type="PanelContainer" parent="."]
visible = false
layout_mode = 1
anchors_preset = Control.PRESET_FULL_RECT
script = ExtResource("7_dp")

# 角色详情覆盖层（点击角色卡片时弹出）
[node name="CharacterOverlay" type="PanelContainer" parent="."]
visible = false
layout_mode = 1
anchors_preset = Control.PRESET_FULL_RECT

[node name="CharacterPanelInst" parent="MainLayout/CharacterOverlay" instance=ExtResource("5_cp")]
layout_mode = 1
anchors_preset = Control.PRESET_FULL_RECT
offset_left = 40.0
offset_top = 40.0
offset_right = -40.0
offset_bottom = -40.0

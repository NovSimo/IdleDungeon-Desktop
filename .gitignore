## Godot 4 默认 .gitignore
import/

# Godot 生成的导入缓存
.godot/

# OS 文件
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# 编译产物
build/
export/

# Dependencies
node_modules/

# 工作内存
.workbuddy/

# Codebuddy
.codebuddy/

# 玩家数据（不要提交）
server/data/players/
server/admin_server/data/

# 临时文件
*.log
*.tmp
